# Monad: 10143 = Monad Testnet, 31337 = anvil local
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Dirección del contrato InstallmentRegistry desplegado
NEXT_PUBLIC_REGISTRY_ADDRESS=0xF7a6e0f226ecDc708Af88679F2A9a557E918C321
# Solana (riel de pago): devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# USDC devnet (Circle). Verificar contra https://faucet.circle.com antes de la demo.
NEXT_PUBLIC_SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# --- SOLO SERVIDOR (nunca NEXT_PUBLIC_): verificador de pagos (/api/payments/confirm) ---
# Clave de la cuenta `verifier` del contrato (en Monad Testnet = wallet del deployer, ver docs/progress/STATUS.md).
# En anvil local la cuenta 0 es el verifier: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 (clave pública de anvil, sin valor).
VERIFIER_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
